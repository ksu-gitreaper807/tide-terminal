#!/usr/bin/env bash
# Integrated shells provide A_: as a function; this path also works inside Tide.
set -euo pipefail
if [[ -n ${TIDE_APPEND_SOCKET:-} && ${TIDE_APPEND_NESTED:-} != 1 ]]; then
    printf '\033]777;tide;v1;%s;append;\007' "${TIDE_MARKER_TOKEN:-}"
    if [[ ${TIDE_SPLIT_CAPTURE:-} == 1 ]]; then printf '\033]777;tide;v1;%s;append;\007' "${TIDE_MARKER_TOKEN:-}" >&2; fi
fi
if [[ -n ${TIDE_EXE:-} ]]; then
    exec "$TIDE_EXE" append "$@"
fi
TIDE_APPEND_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [[ -x "$TIDE_APPEND_DIR/tide-terminal" ]]; then
    exec "$TIDE_APPEND_DIR/tide-terminal" append "$@"
fi
exec "$TIDE_APPEND_DIR/run.sh" append "$@"
