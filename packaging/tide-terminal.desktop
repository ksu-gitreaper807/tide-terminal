[Desktop Entry]
Type=Application
Name=Tide Terminal
GenericName=Terminal Emulator
Comment=Terminal with shell integration, input alerts and command timers
Exec=tide-terminal
TryExec=tide-terminal
X-TerminalArgExec=-e
X-TerminalArgDir=--working-directory
X-TerminalArgHold=--hold
Icon=tide-terminal
Terminal=false
Categories=System;TerminalEmulator;
Keywords=shell;console;command;timer;
