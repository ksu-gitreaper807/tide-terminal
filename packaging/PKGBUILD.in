# Generated by packaging/build-arch.sh with a checksum of the included source.
# Maintainer: Kushal (https://github.com/ksu-gitreaper807)
pkgname=tide-terminal
pkgver=0.1.0
pkgrel=1
pkgdesc='Native terminal with shell integration, input alerts and command timers'
arch=('x86_64')
url='https://github.com/ksu-gitreaper807/tide-terminal'
license=('MIT' 'Apache-2.0' 'OFL-1.1' 'BSD-3-Clause' 'Bitstream-Vera')
depends=('glibc' 'libgcc' 'bash' 'fontconfig' 'libx11' 'libxcursor' 'libxi' 'libxrandr' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'libglvnd' 'vulkan-icd-loader' 'hicolor-icon-theme')
makedepends=('cargo' 'pkgconf')
checkdepends=('python' 'zsh' 'fish' 'less' 'man-db' 'man-pages')
optdepends=('libnotify: desktop input-request notifications'
            'fish: Fish shell integration'
            'zsh: Zsh shell integration'
            'vulkan-driver: GPU driver for your Intel, AMD or NVIDIA hardware')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')
# Avoid host-specific instruction sets and distribution LTO flags. Cargo owns LTO.
options=('!lto')

prepare() {
    cd "$pkgname-$pkgver"
    cargo fetch --locked
}

build() {
    cd "$pkgname-$pkgver"
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/target}"
    export TIDE_PACKAGED=1
    export RUSTFLAGS='-C target-cpu=x86-64'
    export CFLAGS='-O2 -pipe -march=x86-64 -mtune=generic'
    export CXXFLAGS="$CFLAGS"
    cargo build --release --locked --offline
}

check() {
    cd "$pkgname-$pkgver"
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/target}"
    export TIDE_PACKAGED=1
    export TIDE_ASSETS_DIR="$PWD/vendor"
    export RUSTFLAGS='-C target-cpu=x86-64'
    export CFLAGS='-O2 -pipe -march=x86-64 -mtune=generic'
    export CXXFLAGS="$CFLAGS"
    cargo test --locked --offline --all-targets -- --test-threads=1
}

package() {
    cd "$pkgname-$pkgver"
    bash packaging/stage.sh "${CARGO_TARGET_DIR:-$srcdir/target}/release/tide-terminal" "$pkgdir"
}
