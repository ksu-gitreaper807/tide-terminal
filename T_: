#!/usr/bin/env bash
# Standalone entry point. Integrated Tide shells provide the same name as a function.
set -euo pipefail
TIDE_TIMER_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [[ -x "$TIDE_TIMER_DIR/tide-terminal" ]]; then
    exec "$TIDE_TIMER_DIR/tide-terminal" timer "$@"
fi
exec "$TIDE_TIMER_DIR/run.sh" timer "$@"
